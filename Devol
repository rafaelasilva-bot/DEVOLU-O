def buscar_nat_op(cfop_base, icms, ipi, pis_cofins):
    for r in REGRAS_ERP:
        if (
            r["cfop"] == cfop_base
            and r["icms"] == icms
            and r["ipi"] == float(ipi)
            and r["pis_cofins"] == float(pis_cofins)
        ):
            return r
    return None


tab1, tab2, tab3 = st.tabs(
    [
        "🎛️ Consulta Rápida por Regra",
        "📄 Ler Nota via XML",
        "📋 Ver Tabela de Naturezas ERP",
    ]
)

with tab1:
    st.subheader(
        "Informe as Condições da Nota para obter a Natureza de Operação"
    )

    col1, col2 = st.columns(2)
    with col1:
        uf_emit = st.selectbox(
            "UF do Cliente (Emitente NFD)",
            ["SP", "RJ", "MG", "PR", "SC", "RS", "BA", "GO", "PE", "CE"],
            index=1,
        )
        uf_dest = st.selectbox(
            "UF da Sua Empresa (Destinatário)",
            ["SP", "RJ", "MG", "PR", "SC", "RS"],
            index=0,
        )
        forma_obt = st.selectbox(
            "Forma de Obtenção do Item",
            ["Comprado", "Fabricado"],
            help="Fabricado = Família 1201/2201 | Comprado = Família 1202/2202",
        )

    with col2:
        icms = st.selectbox(
            "Situação ICMS (Aba CST ICMS)",
            ["T", "R", "I"],
            help="T = Tributado | R = Reduzido | I = Isento",
        )
        ipi = st.selectbox(
            "CST IPI de Entrada",
            [1.0, 0.0, 3.0],
            help="1 = Trib Alíquota Zero | 0 = Com Crédito | 3 = Não Tributado",
        )
        pis_cofins = st.selectbox(
            "CST PIS/COFINS de Entrada",
            [54.0, 70.0, 73.0],
            help="54 = Com Crédito | 70 = Sem Crédito | 73 = Alíquota Zero",
        )

    if st.button("🔍 Encontrar Natureza de Operação", type="primary"):
        is_interna = uf_emit == uf_dest
        cfop_base = (
            ("1201" if is_interna else "2201")
            if forma_obt == "Fabricado"
            else ("1202" if is_interna else "2202")
        )

        resultado = buscar_nat_op(cfop_base, icms, ipi, pis_cofins)

        if resultado:
            st.success(f"### Natureza de Operação ERP: **{resultado['nat_op']}**")
            st.metric(label="Código da Natureza no ERP", value=resultado["nat_op"])
            st.info(
                f"**Código Interno (Chave):** `{resultado['cod']}`\n\n**Descrição Fiscal:** {resultado['desc']}"
            )
        else:
            st.warning(
                f"Nenhuma Natureza de Operação cadastrada para a combinação: CFOP Base {cfop_base} | ICMS {icms} | IPI {ipi} | PIS {pis_cofins}"
            )

with tab2:
    st.subheader("Upload do XML da NF-e")
    xml_file = st.file_uploader(
        "Arraste e solte o XML enviado pelo cliente", type=["xml"]
    )

    if xml_file:
        try:
            tree = ET.parse(xml_file)
            root = tree.getroot()
            ns = {"nfe": "http://www.portalfiscal.inf.br/nfe"}

            uf_emit = root.find(".//nfe:emit/nfe:enderEmit/nfe:UF", ns).text
            uf_dest = root.find(".//nfe:dest/nfe:enderDest/nfe:UF", ns).text

            st.info(
                f"📍 **Origem:** {uf_emit} -> **Destino:** {uf_dest} ({'Operação Interna' if uf_emit == uf_dest else 'Operação Interestadual'})"
            )

            forma_obt = st.radio(
                "Selecione a Origem dos Itens no seu cadastro",
                ["Comprado", "Fabricado"],
                horizontal=True,
            )
            icms = st.selectbox("ICMS da Operação", ["T", "R", "I"], key="xml_icms")
            ipi = st.selectbox("CST IPI Entrada", [1.0, 0.0, 3.0], key="xml_ipi")
            pis_cofins = st.selectbox(
                "CST PIS/COFINS Entrada", [54.0, 70.0, 73.0], key="xml_pis"
            )

            if st.button("Determinar Natureza do XML"):
                is_interna = uf_emit == uf_dest
                cfop_base = (
                    ("1201" if is_interna else "2201")
                    if forma_obt == "Fabricado"
                    else ("1202" if is_interna else "2202")
                )
                resultado = buscar_nat_op(cfop_base, icms, ipi, pis_cofins)
                if resultado:
                    st.success(
                        f"### Use no ERP: Natureza **{resultado['nat_op']}** (Código `{resultado['cod']}`)"
                    )
        except Exception as e:
            st.error(f"Erro ao ler o XML: {e}")

